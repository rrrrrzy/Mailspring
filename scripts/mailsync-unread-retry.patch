+    const auto kind = data["unread"].get<bool>() ? IMAPStoreFlagsRequestKindRemove : IMAPStoreFlagsRequestKindAdd;
+    session->storeFlagsByUID(path, uids, kind, MessageFlagSeen, &err);
+    constexpr int maxRetries = 3;
+    for (int retry = 1; err == ErrorCode::ErrorConnection && retry <= maxRetries; ++retry) {
+        auto logger = spdlog::get("logger");
+        logger->info("ChangeUnreadTask retry {}/{}: reconnecting after ErrorConnection", retry, maxRetries);
+        session->disconnect();
+        session->selectIfNeeded(path, &err);
+        if (err != ErrorCode::ErrorNone) {
+            auto error = SyncException(err, "reselect before storeFlagsByUID");
+            logger->warn("ChangeUnreadTask retry {}/{}: select failed ({})", retry, maxRetries, error.key);
+            if (err != ErrorCode::ErrorConnection || retry == maxRetries) {
+                throw error;
+            }
+            continue;
+        }
+
+        const auto & status = source.localStatus();
+        const auto uidValidity = status.find(LS_UIDVALIDITY);
+        if (uidValidity == status.end() || !uidValidity->is_number_integer() ||
+            session->uidValidity() == 0 || *uidValidity != session->uidValidity()) {
+            logger->warn("ChangeUnreadTask retry {}/{}: UIDVALIDITY unavailable or changed", retry, maxRetries);
+            throw SyncException("uidvalidity-changed", "reselect before storeFlagsByUID", false);
+        }
+
+        session->storeFlagsByUID(path, uids, kind, MessageFlagSeen, &err);
+        const auto result = err == ErrorCode::ErrorNone ? "success" : SyncException(err, "").key;
+        logger->info("ChangeUnreadTask retry {}/{}: STORE {}", retry, maxRetries, result);
     }
     if (err != ErrorCode::ErrorNone) {
         throw SyncException(err, "storeFlagsByUID");
