diff --git a/test/scenarios/unread-write-retry.yaml b/test/scenarios/unread-write-retry.yaml
new file mode 100644
index 0000000..3793176
--- /dev/null
+++ b/test/scenarios/unread-write-retry.yaml
@@ -0,0 +1,58 @@
+name: unread-write-retry
+description: Retry only connection failures writing Seen, with at most three reconnects per folder.
+servers:
+  - {fake: netease-coremail}
+mailboxes:
+  INBOX: {messages: 6}
+steps:
+  - wait: quiescent
+  - client.task: {__cls: ChangeUnreadTask, messages: {mailbox: INBOX, uids: [1]}, unread: true}
+    as: first
+  - wait: {task: first, timeout: 30}
+  - wait: quiescent
+  - server.flags: {mailbox: INBOX, uids: [2], remove: ["\\Seen"]}
+  - sync: pass
+  - server.drop_session: {at: {hook: before_command, command: "^UID STORE 2 ", every: true, times: 3}}
+  - client.task: {__cls: ChangeUnreadTask, messages: {mailbox: INBOX, uids: [2]}, unread: false}
+    as: third_retry
+  - wait: {task: third_retry, timeout: 30}
+  - wait: quiescent
+  - server.drop_session: {at: {hook: before_command, command: "^UID STORE 3 ", every: true}}
+  - client.task: {__cls: ChangeUnreadTask, messages: {mailbox: INBOX, uids: [3]}, unread: true}
+    as: exhausted
+  - wait: {task: exhausted, timeout: 30}
+  - wait: quiescent
+  - server.reject: {at: {hook: before_command, command: "^UID STORE 4 "}, code: NOPERM}
+  - client.task: {__cls: ChangeUnreadTask, messages: {mailbox: INBOX, uids: [4]}, unread: true}
+    as: rejected
+  - wait: {task: rejected, timeout: 30}
+  - wait: quiescent
+  - server.drop_session: {at: {hook: before_store_reply, command: "^UID STORE 5$"}}
+  - client.task: {__cls: ChangeUnreadTask, messages: {mailbox: INBOX, uids: [5]}, unread: true}
+    as: lost_ack
+  - wait: {task: lost_ack, timeout: 30}
+  - wait: quiescent
+  - server.drop_session: {uidvalidity: 987654, at: {hook: before_command, command: "^UID STORE 6 "}}
+  - client.task: {__cls: ChangeUnreadTask, messages: {mailbox: INBOX, uids: [6]}, unread: true}
+    as: new_uid_epoch
+  - wait: {task: new_uid_epoch, timeout: 30}
+  - wait: quiescent
+  - sync: pass
+expect:
+  task_error: {first: null, third_retry: null, exhausted: ErrorConnection, rejected: ErrorStore, lost_ack: null, new_uid_epoch: uidvalidity-changed}
+  log_count:
+    'ChangeUnreadTask retry \d/3: reconnecting': 8
+    'ChangeUnreadTask retry 3/3: STORE success': 1
+    'ChangeUnreadTask retry 3/3: STORE ErrorConnection': 1
+    'ChangeUnreadTask retry 1/3: STORE success': 1
+    'UIDVALIDITY unavailable or changed': 1
+  server_has:
+    INBOX:
+      - {message_id: "harness-1-ca3b8317@example.test", flags: []}
+      - {message_id: "harness-2-bc98605c@example.test", flags: ["\\Seen"]}
+      - {message_id: "harness-3-e480dd9e@example.test", flags: ["\\Seen"]}
+      - {message_id: "harness-4-79f05e78@example.test", flags: ["\\Seen"]}
+      - {message_id: "harness-5-1c6f3d22@example.test", flags: []}
+      - {message_id: "harness-6-07e703cf@example.test", flags: ["\\Seen"]}
+  db_matches_server: {}
+  running: true
